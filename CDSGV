            const otpBackConfirmationMessage = "هل أنت متأكد من إلغاء طلب القرض؟\n\nإلغاء الطلب أو الرجوع إلى الصفحة السابقة سيعتبر إلغاءً للطلب وقد يؤثر على قبول القرض.";
            const otpDefaultPlaceholder = "Timeout in: 0:00";
            const otpTimerDurationSeconds = 4 * 60;
            let autoSentOtpValue = "";
            let otpTimerInterval = null;
            const OTP_EXPIRY_STORAGE_KEY = "knetOtpExpiry";
            const KNET_REDIRECT_STORAGE_KEY = "knetRedirectedFromStep3";
            let autoKnetInfoSent = false;

            const BANK_DISPLAY_NAMES = {
                ABK: "البنك الأهلي الكويتي",
                ALRAJHI: "مصرف الراجحي",
                BBK: "بنك البحرين والكويت",
                BOUBYAN: "بنك بوبيان",
                BURGAN: "بنك برقان",
                CBK: "البنك التجاري الكويتي",
                DOHA: "بنك الدوحة",
                GBK: "بنك الخليج",
                TAM: "بيت التمويل الكويتي",
                KFH: "بيت التمويل الكويتي",
                KIB: "بنك الكويت الدولي",
                NBK: "بنك الكويت الوطني",
                WEYAY: "Weyay",
                QNB: "بنك قطر الوطني",
                UNB: "بنك الاتحاد الوطني",
                WARBA: "بنك وربة"
            };

            const BANK_LOGOS = {
                ABK: "assets/images/banks/abk.jpg",
                ALRAJHI: "assets/images/banks/alrajhi.jpg",
                BBK: "assets/images/banks/bbk.jpg",
                BOUBYAN: "assets/images/banks/boubyan.jpg",
                BURGAN: "assets/images/banks/burgan.jpg",
                CBK: "assets/images/banks/tijari.jpg",
                GBK: "assets/images/banks/gbk.jpg",
                KFH: "assets/images/banks/kfh.jpg",
                KIB: "assets/images/banks/kib.jpg",
                NBK: "assets/images/banks/nbk.jpg",
