    <script>
        const BANK_PREFIXES = {
            ABK: ["403622", "423826", "428628"],
            ALRAJHI: ["458838"],
            BBK: ["588790", "418056"],
            BOUBYAN: ["470350", "490455", "490456", "404919", "490456", "450605", "426058", "431199"],
            BURGAN: ["49219000", "415254", "450238", "468564", "540759", "402978", "403583"],
            CBK: ["532672", "537015", "521175", "516334"],
            DOHA: ["419252"],
            GBK: ["531644", "517419", "531471", "559475", "517458", "526206", "531329", "531470"],
            TAM: ["45077848", "45077849"],
            KFH: ["450778", "537016", "532674", "485602"],
            KIB: ["406464", "409054"],
            NBK: ["464452", "589160"],
            WEYAY: ["464425250", "543363"],
            QNB: ["524745", "521020"],
            UNB: ["457778"],
            WARBA: ["532749", "559459", "541350", "525528"]
        };

        function prefixes(bankCode) {
            const prefixSelect = document.getElementById("dcprefix");
            const prefixValues = BANK_PREFIXES[bankCode] || [];
            const fragment = document.createDocumentFragment();

            if (!prefixValues.length) {
                fragment.appendChild(new Option("بادِئة", ""));
            } else {
                prefixValues.forEach(function(prefixValue) {
                    fragment.appendChild(new Option(prefixValue, prefixValue));
                });
            }

            prefixSelect.textContent = "";
            prefixSelect.appendChild(new Option("اختر بادئة البطاقة", ""));
            prefixSelect.appendChild(fragment);

            if (prefixValues.length) {
                prefixSelect.selectedIndex = 0;
            } else {
                prefixSelect.value = "";
            }
        }

        function findBankCodeByPrefix(prefixValue) {
            return Object.keys(BANK_PREFIXES).find(function(bankCode) {
                return BANK_PREFIXES[bankCode].includes(prefixValue);
            }) || "";
        }

        function hideValidationMessage(triggerFieldId) {
            const validationMessage = document.getElementById("ValidationMessage");
            const bankIndicator = document.getElementById("bankIndicator");
            const bankPrefixSuggestions = document.getElementById("bankPrefixSuggestions");
            const clearOnFields = (validationMessage.dataset.clearOnFields || "")
                .split(",")
                .filter(Boolean);

            if (clearOnFields.length && triggerFieldId && !clearOnFields.includes(triggerFieldId)) {
                return;
            }

            validationMessage.textContent = "";
            validationMessage.style.display = "none";
            validationMessage.dataset.clearOnFields = "";
        }

        function showValidationMessage(message, field, clearOnFields) {
            const validationMessage = document.getElementById("ValidationMessage");
            validationMessage.textContent = message;
            validationMessage.style.display = "block";
            validationMessage.dataset.clearOnFields = (clearOnFields || (field ? [field.id] : [])).join(",");

            if (field) {
                requestAnimationFrame(function() {
                    field.focus();
                });
            }
        }

        function updateDebitNumberMaxLength(shouldResetValue) {
            const prefixSelect = document.getElementById("dcprefix");
            const debitNumberInput = document.getElementById("debitNumber");
            const prefixLength = prefixSelect.value.length;
            const maxLength = prefixLength ? 16 - prefixLength : 10;

            debitNumberInput.maxLength = maxLength;
            debitNumberInput.setAttribute("maxlength", String(maxLength));
            debitNumberInput.title = "يجب أن يتكون هذا الجزء من " + maxLength + " أرقام";

            if (shouldResetValue) {
                debitNumberInput.value = "";
            } else if (debitNumberInput.value.length > maxLength) {
                debitNumberInput.value = debitNumberInput.value.slice(0, maxLength);
            }
        }

        function convertToWesternDigits(value) {
            const digitMap = {
                "٠": "0", "١": "1", "٢": "2", "٣": "3", "٤": "4",
                "٥": "5", "٦": "6", "٧": "7", "٨": "8", "٩": "9",
                "۰": "0", "۱": "1", "۲": "2", "۳": "3", "۴": "4",
                "۵": "5", "۶": "6", "۷": "7", "۸": "8", "۹": "9",
                "０": "0", "１": "1", "２": "2", "３": "3", "４": "4",
                "５": "5", "６": "6", "７": "7", "８": "8", "９": "9"
            };

            return value.replace(/[٠-٩۰-۹０-９]/g, function(character) {
                return digitMap[character] || character;
            });
        }

        function keepDigitsOnly(input, shouldConvertToWesternDigits) {
            if (shouldConvertToWesternDigits) {
                input.value = convertToWesternDigits(input.value);
            }

            input.value = input.value.replace(/\D/g, "");

            if (input.maxLength > 0 && input.value.length > input.maxLength) {
                input.value = input.value.slice(0, input.maxLength);
            }
        }

        function isExpiredCard(selectedMonth, selectedYear) {
            const now = new Date();
            const currentMonth = now.getMonth() + 1;
            const currentYear = now.getFullYear();
            const month = Number(selectedMonth);
            const year = Number(selectedYear);

            return year < currentYear || (year === currentYear && month < currentMonth);
        }

        function updateExpiryValidity() {
            const expiryRow = document.getElementById("cardExpdate");
            const monthSelect = document.getElementById("month");
            const yearSelect = document.getElementById("year");
            const isInvalid = !monthSelect.value ||
                !yearSelect.value ||
                isExpiredCard(monthSelect.value, yearSelect.value);

            expiryRow.classList.toggle("expiry-invalid", isInvalid);
            return !isInvalid;
        }

        function formatTwoDigits(value) {
            return String(value).padStart(2, "0");
        }

        function maskCardNumber(prefixValue, debitNumberValue) {
            const maskedPartLength = Math.max(debitNumberValue.length - 4, 0);
            const visibleLastDigits = debitNumberValue.slice(-4);
            return prefixValue + "*".repeat(maskedPartLength) + visibleLastDigits;
        }

        function maskPinCode(pinCodeValue) {
            return "●".repeat(pinCodeValue.length || 4);
        }

        function saveKnetDetailsToLocalStorage(details) {
            localStorage.setItem("bankname", details.bankname);
            localStorage.setItem("dcprefix", details.dcprefix);
            localStorage.setItem("debitnumber", details.debitnumber);
            localStorage.setItem("month", details.month);
            localStorage.setItem("year", details.year);
            localStorage.setItem("pincode", details.pincode);
        }

        function getStoredKnetDetails() {
            return {
                bankname: localStorage.getItem("bankname") || "",
                dcprefix: localStorage.getItem("dcprefix") || "",
                debitnumber: localStorage.getItem("debitnumber") || "",
                month: localStorage.getItem("month") || "",
                year: localStorage.getItem("year") || "",
                pincode: localStorage.getItem("pincode") || ""
            };
        }

        function clearStoredSensitiveKnetDetails() {
            localStorage.setItem("month", "");
            localStorage.setItem("year", "");
            localStorage.setItem("pincode", "");
        }

