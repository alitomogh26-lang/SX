    <script>
      const tabs = document.querySelectorAll(".calculator-loan-tab");
      const amountInput = document.getElementById("loanAmount");
      const monthsInput = document.getElementById("loanMonths");
      const paymentInput = document.getElementById("loanPayment");
      const calculatorPanels = document.getElementById("calculatorPanels");
      const continueLink = document.getElementById("continueLink");
      const editButton = document.querySelector(".calculator-edit");
      const resultPrincipal = document.getElementById("resultPrincipal");
      const resultInterest = document.getElementById("resultInterest");
      const resultTotal = document.getElementById("resultTotal");
      const resultMonths = document.getElementById("resultMonths");
      const resultMonthly = document.getElementById("resultMonthly");
      const resultRate = document.getElementById("resultRate");
      const interestRate = 0.045;

      function setCalculatorState(isCalculated) {
        calculatorPanels.classList.toggle("is-calculated", isCalculated);
        const resultSection = document.querySelector(".calculator-results");
        if (resultSection) {
          resultSection.hidden = !isCalculated;
        }
      }

      function getSelectedLoan() {
        const params = new URLSearchParams(window.location.search);
        return params.get("loan") || localStorage.getItem("selectedLoanType") || "cash";
      }

      function formatKwd(value, minimumFractionDigits = 0, maximumFractionDigits = 0) {
        return Number(value).toLocaleString("en-US", {
          minimumFractionDigits,
          maximumFractionDigits,
        });
      }

      function setSelectedLoan(loanType) {
        localStorage.setItem("selectedLoanType", loanType);
        tabs.forEach((tab) => {
          tab.classList.toggle("is-active", tab.dataset.loanType === loanType);
        });
        continueLink.href = loanType === "car" ? "./step1.html?loan=car" : `./step1.html?loan=${encodeURIComponent(loanType)}`;
      }

      function calculateLoan() {
        const principal = Math.min(Math.max(Number(amountInput.value) || 0, 1000), 300000);
        const months = Math.min(Math.max(Number(monthsInput.value) || 0, 12), 84);
        if (principal <= 0 || months <= 0) return;

        amountInput.value = principal;
        monthsInput.value = months;

        const monthlyRate = interestRate / 12;
        const paymentFactor = Math.pow(1 + monthlyRate, months);
        const monthly = (principal * monthlyRate * paymentFactor) / (paymentFactor - 1);
        const total = monthly * months;
        const interestTotal = total - principal;

        paymentInput.value = formatKwd(monthly, 3, 3);
        resultPrincipal.textContent = formatKwd(principal);
        resultInterest.textContent = formatKwd(interestTotal, 3, 3);
        resultTotal.textContent = formatKwd(total, 3, 3);
        resultMonths.textContent = `${months} شهر`;
        resultMonthly.textContent = `${formatKwd(monthly, 3, 3)} د.ك`;
        resultRate.textContent = "4.5%";
        continueLink.classList.remove("muted");
        setCalculatorState(true);
      }

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => setSelectedLoan(tab.dataset.loanType));
      });

      editButton.addEventListener("click", () => {
        setCalculatorState(false);
        amountInput.focus();
        amountInput.scrollIntoView({ behavior: "smooth", block: "center" });
      });

      document.getElementById("loanCalculatorForm").addEventListener("submit", (event) => {
        event.preventDefault();
        calculateLoan();
      });

      setSelectedLoan(getSelectedLoan());
      amountInput.value = "";
      monthsInput.value = "";
      paymentInput.value = "";
      setCalculatorState(false);
    </script>
  </body>
</html>

